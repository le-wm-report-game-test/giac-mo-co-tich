# Godot 4+ specific ignores
.godot/
/android/

# Godot export and temporary files
export.cfg
export_credentials.cfg
*.tmp

# Native library files locked by a running Godot process on Windows (the
# editor creates `~libname.dll` next to the real one while loading).
~*.dll
~*.so
~*.dylib

# Windows git creates `~name.dll~RFxxxxx.TMP` lock files during atomic
# unlink/rename. Cover both the leading-`~` pattern and the trailing
# `.TMP` (case-insensitive) so leftover lock files cannot be committed.
*.TMP
*~*.dll
*~*.so
*~*.dylib

# Terrain3D native binaries: built once from the addon's own build script,
# then reused locally. Tracking 14 platform-specific binaries bloats the
# repo without giving cross-platform devs anything they can use. Build from
# source for your target platform (`addons/terrain_3d/SConstruct`).
addons/terrain_3d/bin/libterrain.*.dll
addons/terrain_3d/bin/libterrain.*.so
addons/terrain_3d/bin/libterrain.*.dylib
addons/terrain_3d/bin/libterrain.*.wasm
addons/terrain_3d/bin/libterrain.*.framework/

# Godot 3 specific legacy folder (just in case)
.import/

# Python compiled bytecode and cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Log files (e.g. test logs)
*.log

# Zip archives (raw download files, assets should be extracted)
*.zip

# OS-specific files
.DS_Store
Thumbs.db
Desktop.ini

# IDEs and Text Editors
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.vscode/
